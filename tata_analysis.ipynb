import pandas as pd
import yfinance as yf
from datetime import datetime

# Download Tata Motors stock data (5 years)
print("Downloading Tata Motors data...")
tata = yf.download('TATAMOTORS.NS', start='2021-09-01', end='2026-09-09', progress=False)

print("="*70)
print("TATA MOTORS STOCK ANALYSIS")
print("="*70)
print(f"Analysis Date: {datetime.now().strftime('%B %d, %Y')}")
print("\n")

print("="*70)
print("5-YEAR OVERVIEW")
print("="*70)
print(f"Current Price: ₹{tata['Close'].iloc[-1]:.2f}")
print(f"Highest Price (5Y): ₹{tata['Close'].max():.2f}")
print(f"Lowest Price (5Y): ₹{tata['Close'].min():.2f}")
print(f"Average Price: ₹{tata['Close'].mean():.2f}")
print(f"Price Change (5Y): ₹{tata['Close'].iloc[-1] - tata['Close'].iloc[0]:.2f}")
print(f"Percentage Change: {((tata['Close'].iloc[-1] - tata['Close'].iloc[0]) / tata['Close'].iloc[0] * 100):.2f}%")
print("\n")

print("="*70)
print("RECENT TREND (Last 30 Days)")
print("="*70)
recent = tata['Close'].tail(30)
print(f"30-Day Average: ₹{recent.mean():.2f}")
print(f"30-Day High: ₹{recent.max():.2f}")
print(f"30-Day Low: ₹{recent.min():.2f}")
print("\n")

print("="*70)
print("LAST 10 TRADING DAYS")
print("="*70)
print(tata[['Close', 'Volume']].tail(10).to_string())
